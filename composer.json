{
    "name": "automattic/wpcom-migration-dev",
    "description": "Development tooling for the Migrate to WordPress.com plugin repository.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "build": "bin/build.sh",
        "lint": "phpcs",
        "lint:php:compat": "phpcs --standard=PHPCompatibility --runtime-set testVersion 7.1- -ps plugin/reprint bin tests",
        "test:e2e": "tests/e2e/run.sh build/wpcom-migration"
    }
}
