{
    "name": "automattic/wpcom-migration",
    "description": "Runtime dependencies of the Migrate to WordPress.com plugin.",
    "license": "GPL-2.0-or-later",
    "version": "dev-trunk",
    "require": {
        "php": ">=7.1",
        "automattic/jetpack-autoloader": "^6",
        "wp-php-toolkit/reprint-server": "0.10.8"
    },
    "autoload": {
        "classmap": [
            "reprint/"
        ]
    },
    "config": {
        "allow-plugins": {
            "automattic/jetpack-autoloader": true
        },
        "platform-check": false,
        "sort-packages": true
    },
    "prefer-stable": true
}
