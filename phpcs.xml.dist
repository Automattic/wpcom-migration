<?xml version="1.0"?>
<ruleset name="wpcom-migration">
	<description>Coding standards for the code this repository owns. The BlogVault tree under plugin/ is upstream code and is not checked.</description>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>

	<config name="text_domain" value="wpcom-migration"/>
	<config name="minimum_wp_version" value="4.0"/>

	<file>plugin/reprint</file>
	<file>bin</file>
	<file>tests</file>
	<file>tools/php56-build</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>tools/php56-build/tests/Fixture/*</exclude-pattern>

	<!-- Plugin glue: the full WordPress standard. -->
	<rule ref="WordPress">
		<exclude-pattern>bin/*</exclude-pattern>
		<exclude-pattern>tests/*</exclude-pattern>
		<exclude-pattern>tools/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wpcom_migration"/>
				<element value="Automattic\WPCOM_Migration"/>
			</property>
		</properties>
	</rule>

	<!-- CLI scripts: formatting and docs, not the WordPress runtime rules. -->
	<rule ref="WordPress-Core">
		<exclude-pattern>tools/*</exclude-pattern>
	</rule>
	<rule ref="WordPress-Docs">
		<exclude-pattern>tools/*</exclude-pattern>
	</rule>

	<!-- The build tool is a copy of reprint/tools/php56-build and keeps its style. -->
	<rule ref="PSR12">
		<exclude-pattern>plugin/*</exclude-pattern>
		<exclude-pattern>bin/*</exclude-pattern>
		<exclude-pattern>tests/*</exclude-pattern>
		<exclude name="Generic.Files.LineLength"/>
	</rule>
</ruleset>
