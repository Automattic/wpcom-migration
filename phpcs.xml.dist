<?xml version="1.0"?>
<ruleset name="wpcom-migration">
	<description>Coding standards for the code this repository owns. The BlogVault tree under plugin/ is upstream code and is not checked; tools/php56-build has its own ruleset.</description>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>

	<config name="text_domain" value="wpcom-migration"/>
	<config name="minimum_wp_version" value="4.0"/>

	<file>plugin/reprint</file>
	<file>bin</file>
	<file>tests</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>

	<!--
		Scoping is done with include-pattern, not exclude-pattern: PHPCS unions
		the patterns of a sniff across every rule block that names it, which
		makes an exclude on one block leak into the others. Rules must be ordered
		so more specific standards (WordPress-Core, WordPress-Docs) precede more
		general ones (WordPress).
	-->

	<!-- CLI scripts: formatting and docs, not the WordPress runtime rules. -->
	<rule ref="WordPress-Core">
		<include-pattern>*/bin/*</include-pattern>
		<include-pattern>*/tests/*</include-pattern>
	</rule>
	<rule ref="WordPress-Docs">
		<include-pattern>*/bin/*</include-pattern>
		<include-pattern>*/tests/*</include-pattern>
	</rule>

	<!-- Plugin glue: the full WordPress standard. -->
	<rule ref="WordPress">
		<include-pattern>*/plugin/reprint/*</include-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wpcom_migration"/>
				<element value="Automattic\WPCOM_Migration"/>
			</property>
		</properties>
	</rule>
</ruleset>
